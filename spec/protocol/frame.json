{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://femux.dev/protocol/frame.json",
  "title": "femux protocol: frames",
  "$defs": {
    "FrameSubscribe": {
      "type": "object",
      "properties": {
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        }
      },
      "required": [
        "view_id"
      ]
    },
    "FrameAck": {
      "type": "object",
      "properties": {
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "frame_seq": {
          "$ref": "common.json#/$defs/U64"
        }
      },
      "required": [
        "view_id",
        "frame_seq"
      ]
    },
    "CellRun": {
      "type": "object",
      "description": "Cells starting at (x, y), pane-relative; x advances by each cell's width.",
      "properties": {
        "x": {
          "$ref": "common.json#/$defs/U16"
        },
        "y": {
          "$ref": "common.json#/$defs/U16"
        },
        "run": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/Cell"
          }
        }
      },
      "required": [
        "x",
        "y",
        "run"
      ]
    },
    "PaneFrame": {
      "type": "object",
      "properties": {
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "rect": {
          "$ref": "common.json#/$defs/Rect",
          "description": "Pane area within the view."
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CellRun"
          }
        },
        "cursor": {
          "$ref": "common.json#/$defs/Cursor"
        },
        "scroll_offset": {
          "$ref": "common.json#/$defs/U32",
          "description": "Rows scrolled back from the bottom."
        }
      },
      "required": [
        "pane_id",
        "rect",
        "cells",
        "cursor",
        "scroll_offset"
      ]
    },
    "TabInfo": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "title": {
          "type": "string"
        },
        "index": {
          "$ref": "common.json#/$defs/U32"
        },
        "count": {
          "$ref": "common.json#/$defs/U32"
        }
      },
      "required": [
        "id",
        "title",
        "index",
        "count"
      ]
    },
    "ImagePlacement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "common.json#/$defs/U32",
          "description": "Placement id within the image (Kitty `p`; 0 when the program gave none)."
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "x": {
          "$ref": "common.json#/$defs/I32",
          "description": "Column of the top-left cell, relative to the pane; negative when cut off."
        },
        "y": {
          "$ref": "common.json#/$defs/I32",
          "description": "Row of the top-left cell, relative to the pane; negative when scrolled partly off."
        },
        "cols": {
          "$ref": "common.json#/$defs/U16"
        },
        "rows": {
          "$ref": "common.json#/$defs/U16"
        },
        "image_id": {
          "$ref": "common.json#/$defs/U32",
          "description": "The pane's image (Kitty `i`; sixels get ids of their own, ADR-021)."
        },
        "generation": {
          "$ref": "common.json#/$defs/U64",
          "description": "Changes whenever the image's pixels do; clients refetch then."
        },
        "src_x": {
          "$ref": "common.json#/$defs/U32"
        },
        "src_y": {
          "$ref": "common.json#/$defs/U32"
        },
        "src_w": {
          "$ref": "common.json#/$defs/U32",
          "description": "The part of the image shown, in pixels."
        },
        "src_h": {
          "$ref": "common.json#/$defs/U32"
        },
        "x_off": {
          "$ref": "common.json#/$defs/U32",
          "description": "Pixel offset inside the first cell."
        },
        "y_off": {
          "$ref": "common.json#/$defs/U32"
        },
        "z": {
          "$ref": "common.json#/$defs/I32",
          "description": "Negative: below text."
        }
      },
      "required": [
        "id",
        "pane_id",
        "x",
        "y",
        "cols",
        "rows",
        "image_id",
        "generation",
        "src_x",
        "src_y",
        "src_w",
        "src_h",
        "z"
      ],
      "description": "An image on screen (REQ-GFX-001, REQ-UI-052): position and size in cells relative to the pane, the part of the image shown, and what to fetch with image.read."
    },
    "Frame": {
      "type": "object",
      "properties": {
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "frame_seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "full": {
          "type": "boolean",
          "description": "Every visible pane with every row; otherwise only changed rows of changed panes."
        },
        "panes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PaneFrame"
          }
        },
        "tab": {
          "$ref": "#/$defs/TabInfo"
        },
        "images": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ImagePlacement"
          }
        }
      },
      "required": [
        "view_id",
        "frame_seq",
        "full",
        "panes",
        "tab",
        "images"
      ]
    }
  },
  "x-messages": [
    {
      "kind": "frame.subscribe",
      "request": "FrameSubscribe",
      "response": "Empty"
    },
    {
      "kind": "frame.ack",
      "request": "FrameAck",
      "response": "Empty"
    }
  ],
  "x-pushes": [
    {
      "kind": "frame",
      "body": "Frame"
    }
  ]
}
