{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://femux.dev/protocol/events.json",
  "title": "femux protocol: event bus",
  "description": "Events are pushed with envelope id 0. Every event body carries seq (monotonic per daemon) and ts.",
  "$defs": {
    "EventsSubscribe": {
      "type": "object",
      "properties": {
        "kinds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "session": {
          "$ref": "common.json#/$defs/SessionName"
        },
        "pane": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "since": {
          "$ref": "common.json#/$defs/U64",
          "description": "Replay retained events with seq > since first."
        }
      }
    },
    "EventsUnsubscribe": {
      "type": "object",
      "description": "No fields."
    },
    "SessionCreated": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "name": {
          "$ref": "common.json#/$defs/SessionName"
        }
      },
      "required": [
        "seq",
        "ts",
        "name"
      ]
    },
    "SessionRenamed": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "name": {
          "$ref": "common.json#/$defs/SessionName"
        },
        "new": {
          "$ref": "common.json#/$defs/SessionName"
        }
      },
      "required": [
        "seq",
        "ts",
        "name",
        "new"
      ]
    },
    "SessionClosed": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "name": {
          "$ref": "common.json#/$defs/SessionName"
        }
      },
      "required": [
        "seq",
        "ts",
        "name"
      ]
    },
    "TabCreated": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "session": {
          "$ref": "common.json#/$defs/SessionName"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "index": {
          "$ref": "common.json#/$defs/U32",
          "description": "Position of the new tab in its session."
        }
      },
      "required": [
        "seq",
        "ts",
        "session",
        "tab_id",
        "index"
      ]
    },
    "TabSelected": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        }
      },
      "required": [
        "seq",
        "ts",
        "view_id",
        "tab_id"
      ]
    },
    "TabClosed": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "session": {
          "$ref": "common.json#/$defs/SessionName"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        }
      },
      "required": [
        "seq",
        "ts",
        "session",
        "tab_id"
      ]
    },
    "TabMoved": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "index": {
          "$ref": "common.json#/$defs/U32"
        }
      },
      "required": [
        "seq",
        "ts",
        "tab_id",
        "index"
      ]
    },
    "TabRenamed": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "tab_id",
        "title"
      ]
    },
    "LayoutChanged": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "tree": {
          "$ref": "common.json#/$defs/LayoutNode"
        },
        "floats": {
          "type": "array",
          "items": {
            "$ref": "common.json#/$defs/FloatNode"
          }
        },
        "zoomed": {
          "type": "boolean"
        },
        "scheme": {
          "$ref": "common.json#/$defs/Scheme"
        }
      },
      "required": [
        "seq",
        "ts",
        "tab_id",
        "tree",
        "floats",
        "zoomed",
        "scheme"
      ]
    },
    "LayoutFocused": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        }
      },
      "required": [
        "seq",
        "ts",
        "tab_id",
        "pane_id"
      ]
    },
    "PaneMarked": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "mark": {
          "type": "string",
          "pattern": "^[a-z]$"
        },
        "cleared": {
          "type": "boolean",
          "description": "The mark was removed."
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "mark"
      ]
    },
    "PaneSpawned": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "tab_id"
      ]
    },
    "PaneExited": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "code": {
          "$ref": "common.json#/$defs/I32"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "code"
      ]
    },
    "PaneFgChanged": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "pid": {
          "$ref": "common.json#/$defs/U32"
        },
        "cmd": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "pid",
        "cmd"
      ]
    },
    "PaneCwdChanged": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "cwd": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "cwd"
      ]
    },
    "PaneTitleChanged": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "title"
      ]
    },
    "PaneMetaChanged": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "set": {
          "$ref": "pane.json#/$defs/Meta"
        },
        "unset": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "set",
        "unset"
      ]
    },
    "PaneBell": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id"
      ]
    },
    "ViewAttached": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "session": {
          "$ref": "common.json#/$defs/SessionName"
        }
      },
      "required": [
        "seq",
        "ts",
        "view_id",
        "session"
      ]
    },
    "ViewDetached": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "session": {
          "$ref": "common.json#/$defs/SessionName"
        }
      },
      "required": [
        "seq",
        "ts",
        "view_id",
        "session"
      ]
    },
    "ViewResized": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "view_id": {
          "$ref": "common.json#/$defs/ViewId"
        },
        "cols": {
          "$ref": "common.json#/$defs/U16"
        },
        "rows": {
          "$ref": "common.json#/$defs/U16"
        }
      },
      "required": [
        "seq",
        "ts",
        "view_id",
        "cols",
        "rows"
      ]
    },
    "StoreSnapshotted": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        }
      },
      "required": [
        "seq",
        "ts"
      ]
    },
    "EventsLost": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "from": {
          "$ref": "common.json#/$defs/U64",
          "description": "First lost seq."
        },
        "to": {
          "$ref": "common.json#/$defs/U64",
          "description": "Last lost seq."
        }
      },
      "required": [
        "seq",
        "ts",
        "from",
        "to"
      ]
    },
    "ClipboardSource": {
      "type": "string",
      "enum": [
        "pane",
        "client"
      ],
      "description": "pane: OSC 52 from a pane program; client: clipboard.set."
    },
    "ClipboardChanged": {
      "type": "object",
      "description": "The server clipboard changed; attached clients copy `text` to the host clipboard (OSC 52).",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "text": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ClipboardSource"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId",
          "description": "The writing pane when source is pane."
        }
      },
      "required": [
        "seq",
        "ts",
        "text",
        "source"
      ]
    },
    "ConfigReloaded": {
      "type": "object",
      "description": "The daemon applied a new config; clients re-read their part of it.",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        }
      },
      "required": [
        "seq",
        "ts"
      ]
    },
    "PaneProgress": {
      "type": "object",
      "description": "A program in the pane reported progress (OSC 9;4).",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "state": {
          "$ref": "common.json#/$defs/U8",
          "description": "OSC 9;4 state: 0 remove, 1 set, 2 error, 3 indeterminate, 4 pause."
        },
        "value": {
          "$ref": "common.json#/$defs/U8",
          "description": "Percent, when the program gave one."
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "state"
      ]
    },
    "PaneReport": {
      "type": "object",
      "description": "A program in the pane sent the private report sequence OSC 7777.",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "data": {
          "type": "string",
          "description": "What follows `7777;`, e.g. `state=blocked`."
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "data"
      ]
    },
    "TabFlags": {
      "type": "object",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "tab_id": {
          "$ref": "common.json#/$defs/TabId"
        },
        "broadcast": {
          "type": "boolean"
        },
        "floats_hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "seq",
        "ts",
        "tab_id",
        "broadcast",
        "floats_hidden"
      ]
    },
    "PaneOutput": {
      "type": "object",
      "description": "Bytes a pane's program wrote (the recorder plugin). Only for subscribers that name `pane.output` in `kinds`, never retained for `since`.",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "data": {
          "type": "string",
          "description": "Base64 of the bytes."
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "data"
      ]
    },
    "PanePassthrough": {
      "type": "object",
      "description": "One DCS sequence a pane's program wrote, for clients to write to their host terminal verbatim. Sent only while `[terminal] passthrough = true`; never retained for `since`.",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "pane_id": {
          "$ref": "common.json#/$defs/PaneId"
        },
        "data": {
          "type": "string",
          "description": "Base64 of the whole sequence, `ESC P` through `ESC \\`."
        }
      },
      "required": [
        "seq",
        "ts",
        "pane_id",
        "data"
      ]
    },
    "ServerDebugChanged": {
      "type": "object",
      "description": "The daemon's log level changed (REQ-LOG-003); attached clients log at the same level.",
      "properties": {
        "seq": {
          "$ref": "common.json#/$defs/U64"
        },
        "ts": {
          "$ref": "common.json#/$defs/U64",
          "description": "ms since epoch"
        },
        "level": {
          "$ref": "server.json#/$defs/LogLevel"
        }
      },
      "required": [
        "seq",
        "ts",
        "level"
      ]
    }
  },
  "x-messages": [
    {
      "kind": "events.subscribe",
      "request": "EventsSubscribe",
      "response": "Empty"
    },
    {
      "kind": "events.unsubscribe",
      "request": "EventsUnsubscribe",
      "response": "Empty"
    }
  ],
  "x-events": [
    {
      "kind": "session.created",
      "body": "SessionCreated"
    },
    {
      "kind": "session.renamed",
      "body": "SessionRenamed"
    },
    {
      "kind": "session.closed",
      "body": "SessionClosed"
    },
    {
      "kind": "tab.created",
      "body": "TabCreated"
    },
    {
      "kind": "tab.selected",
      "body": "TabSelected"
    },
    {
      "kind": "tab.closed",
      "body": "TabClosed"
    },
    {
      "kind": "tab.moved",
      "body": "TabMoved"
    },
    {
      "kind": "tab.renamed",
      "body": "TabRenamed"
    },
    {
      "kind": "tab.flags",
      "body": "TabFlags"
    },
    {
      "kind": "layout.changed",
      "body": "LayoutChanged"
    },
    {
      "kind": "layout.focused",
      "body": "LayoutFocused"
    },
    {
      "kind": "pane.spawned",
      "body": "PaneSpawned"
    },
    {
      "kind": "pane.exited",
      "body": "PaneExited"
    },
    {
      "kind": "pane.fg_changed",
      "body": "PaneFgChanged"
    },
    {
      "kind": "pane.cwd_changed",
      "body": "PaneCwdChanged"
    },
    {
      "kind": "pane.title_changed",
      "body": "PaneTitleChanged"
    },
    {
      "kind": "pane.meta_changed",
      "body": "PaneMetaChanged"
    },
    {
      "kind": "pane.marked",
      "body": "PaneMarked"
    },
    {
      "kind": "pane.bell",
      "body": "PaneBell"
    },
    {
      "kind": "pane.progress",
      "body": "PaneProgress"
    },
    {
      "kind": "pane.report",
      "body": "PaneReport"
    },
    {
      "kind": "pane.output",
      "body": "PaneOutput"
    },
    {
      "kind": "pane.passthrough",
      "body": "PanePassthrough"
    },
    {
      "kind": "view.attached",
      "body": "ViewAttached"
    },
    {
      "kind": "view.detached",
      "body": "ViewDetached"
    },
    {
      "kind": "view.resized",
      "body": "ViewResized"
    },
    {
      "kind": "clipboard.changed",
      "body": "ClipboardChanged"
    },
    {
      "kind": "store.snapshot",
      "body": "StoreSnapshotted"
    },
    {
      "kind": "config.reloaded",
      "body": "ConfigReloaded"
    },
    {
      "kind": "server.debug_changed",
      "body": "ServerDebugChanged"
    },
    {
      "kind": "events_lost",
      "body": "EventsLost"
    }
  ]
}
